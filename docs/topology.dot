digraph Turing {
  rankdir=TB; compound=true; splines=spline; overlap=false;
  bgcolor="#0a0e1a";
  graph [fontname="DejaVu Sans", fontsize=26, labelloc=t, fontcolor="#e8f0ff",
         label=<<b>TURING PI 2 — BARE-METAL KUBERNETES CLUSTER</b><br/><font point-size="12" color="#7c8db5">GitOps · 6 nodes (arm64 + amd64) · RTX 5090 LLMs · Jetson + RTX 2070 SUPER GPUs · KubeVirt · HA DNS · full observability</font><br/><font point-size="11" color="#c98a4a">the cast: an 80s action/horror lineup — because the players earned it</font>>,
         nodesep=0.45, ranksep=0.75, pad=0.5];
  node [shape=plaintext, fontname="DejaVu Sans"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#3d4b6b", penwidth=1.3, arrowsize=0.7];

  /* ============ EDGE / INGRESS ============ */
  internet [label=<<table border="1" color="#3d4b6b" bgcolor="#0f1729" cellborder="0" cellspacing="0" cellpadding="7"><tr><td><font color="#9fb3d9" point-size="12"><b>Internet</b></font></td></tr></table>>];
  router   [label=<<table border="2" color="#38bdf8" bgcolor="#0f1729" cellborder="0" cellspacing="0" cellpadding="7">
      <tr><td align="left"><font color="#38bdf8" point-size="12"><b>AmpliFi Router · .1</b></font></td></tr>
      <tr><td align="left"><font color="#7c8db5" point-size="9">gateway · DHCP · DNS → Pi-hole</font></td></tr></table>>];
  mikrotik [label=<<table border="2" color="#f97316" bgcolor="#231404" cellborder="0" cellspacing="0" cellpadding="7">
      <tr><td align="left"><font color="#fb923c" point-size="12"><b>MikroTik LAN switch · .233</b></font></td></tr>
      <tr><td align="left"><font color="#f0b46a" point-size="9"><b>[ CARL WEATHERS ]</b> — everyone reports to him</font></td></tr>
      <tr><td align="left"><font color="#c98a4a" point-size="9">managed · webfig :80 · all gear wired here</font></td></tr></table>>];

  /* ============ GITOPS ============ */
  subgraph cluster_gitops {
    label=<<font color="#34d399" point-size="13"><b>  GITOPS  </b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#0b1a14"; color="#1f7a55"; penwidth=2;
    github [label=<<table border="2" color="#34d399" bgcolor="#0f1f18" cellborder="0" cellspacing="0" cellpadding="7">
        <tr><td align="left"><font color="#6ee7b7" point-size="12"><b>GitHub (private)</b></font></td></tr>
        <tr><td align="left"><font color="#9ecbb4" point-size="9"><b>[ THE TERMINATOR ]</b> — the source, relentless</font></td></tr>
        <tr><td align="left"><font color="#8fd9b6" point-size="9">mattarvon/turing-cluster-gitops · app-of-apps</font></td></tr></table>>];
    argocd [label=<<table border="2" color="#34d399" bgcolor="#0f1f18" cellborder="0" cellspacing="0" cellpadding="7">
        <tr><td align="left"><font color="#6ee7b7" point-size="12"><b>Argo CD</b></font></td></tr>
        <tr><td align="left"><font color="#9ecbb4" point-size="9"><b>[ ROBOCOP ]</b> — enforces desired state</font></td></tr>
        <tr><td align="left"><font color="#8fd9b6" point-size="9">ns argocd · :32700 · root → apps/ → manifests/</font></td></tr></table>>];
    github -> argocd [label="deploy key\n(read-only)", color="#34d399", fontcolor="#6ee7b7", penwidth=1.8];
  }

  /* ============ DNS + WORKSTATION ============ */
  subgraph cluster_dns {
    label=<<font color="#6ee7b7" point-size="12"><b>  REDUNDANT DNS — the slashers that keep coming back  </b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#0c1712"; color="#2f6f52"; penwidth=1.6;
    ph1 [label=<<table border="1" color="#34d399" bgcolor="#0f1f18" cellborder="0" cellspacing="0" cellpadding="6"><tr><td><font color="#8fd9b6" point-size="10"><b>pihole · .180 · PRIMARY  [ FREDDY KRUEGER ]</b></font></td></tr></table>>];
    ph2 [label=<<table border="1" color="#2f6f52" bgcolor="#0f1f18" cellborder="0" cellspacing="0" cellpadding="6"><tr><td><font color="#8fd9b6" point-size="10"><b>pihole2 · .181 · BACKUP  [ JASON VOORHEES ]</b></font></td></tr></table>>];
    ph1 -> ph2 [label="nebula-sync", style=dashed, color="#2f6f52", fontcolor="#6ee7b7"];
  }
  ws [label=<<table border="2" color="#a3e635" bgcolor="#151a0d" cellborder="0" cellspacing="0" cellpadding="8">
      <tr><td align="left"><font color="#bef264" point-size="12"><b>Workstation · .110</b></font></td></tr>
      <tr><td align="left"><font color="#d7ef8a" point-size="9"><b>[ DOLPH LUNDGREN ]</b> — the heavyweight</font></td></tr>
      <tr><td align="left"><font color="#d9f99d" point-size="9"><b>RTX 5090 · 32 GB GDDR7 (Blackwell)</b></font></td></tr>
      <tr><td align="left"><font color="#9ca86b" point-size="9">Ryzen 7 9800X3D · 64 GB DDR5-6000 · 2× 2 TB NVMe · Win 11 Pro<br align="left"/>Ollama LLM API — GPU-as-a-service</font></td></tr></table>>];

  /* ============ PHYSICAL NODES ============ */
  subgraph cluster_nodes {
    label=<<font color="#22d3ee" point-size="14"><b>  K3s NODES (6)  </b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#0a1526"; color="#0e7490"; penwidth=2.2;

    subgraph cluster_board {
      label=<<font color="#22d3ee" point-size="12"><b>  Turing Pi 2 board — 3× RK1 + Jetson (on-board switch, single uplink)  </b></font>>; labeljust=l;
      style="rounded,filled"; fillcolor="#0b1a2e"; color="#0891b2"; penwidth=1.8;
      obsw [label=<<table border="1" color="#f59e0b" bgcolor="#241a09" cellborder="0" cellspacing="0" cellpadding="5"><tr><td><font color="#fcd34d" point-size="9"><b>on-board GbE switch</b></font></td></tr></table>>];
      bmc [label=<<table border="1" color="#475569" bgcolor="#0f1729" cellborder="0" cellspacing="0" cellpadding="6">
          <tr><td align="left"><font color="#94a3b8" point-size="10"><b>BMC · .100  [ KURT RUSSELL ]</b></font></td></tr>
          <tr><td align="left"><font color="#64748b" point-size="8">power · flash</font></td></tr></table>>];
      cp [label=<<table border="2" color="#22d3ee" bgcolor="#08283a" cellborder="0" cellspacing="0" cellpadding="7">
          <tr><td align="left"><font color="#67e8f9" point-size="12"><b>rk1-cp · .101 (RK1 #1) · CONTROL PLANE</b></font></td></tr>
          <tr><td align="left"><font color="#a7e6f2" point-size="9"><b>[ SCHWARZENEGGER ]</b> — the commander</font></td></tr>
          <tr><td align="left"><font color="#7dd3e8" point-size="9">RK3588 arm64 · v1.36.2 · 16 GB · 6-TOPS NPU</font></td></tr></table>>];
      jet [label=<<table border="2" color="#fb7185" bgcolor="#2a1015" cellborder="0" cellspacing="0" cellpadding="7">
          <tr><td align="left"><font color="#fda4af" point-size="12"><b>jetson-gpu · .102 · GPU WORKER</b></font></td></tr>
          <tr><td align="left"><font color="#f4b3bb" point-size="9"><b>[ VAN DAMME ]</b> — small, kicks above its weight</font></td></tr>
          <tr><td align="left"><font color="#e79aa5" point-size="9">Tegra arm64 · 256-core Pascal · nvidia.com/gpu</font></td></tr></table>>];
      w1 [label=<<table border="1" color="#3b82f6" bgcolor="#0d1b33" cellborder="0" cellspacing="0" cellpadding="6">
          <tr><td align="left"><font color="#93c5fd" point-size="11"><b>rk1-w1 · .103 (RK1 #2)  [ STALLONE ]</b></font></td></tr>
          <tr><td align="left"><font color="#7c9cc9" point-size="8">RK3588 arm64 · 16 GB · worker</font></td></tr></table>>];
      w2 [label=<<table border="1" color="#3b82f6" bgcolor="#0d1b33" cellborder="0" cellspacing="0" cellpadding="6">
          <tr><td align="left"><font color="#93c5fd" point-size="11"><b>rk1-w2 · .104 (RK1 #3)  [ CHUCK NORRIS ]</b></font></td></tr>
          <tr><td align="left"><font color="#7c9cc9" point-size="8">RK3588 arm64 · 16 GB · worker</font></td></tr></table>>];
    }

    nuc [label=<<table border="2" color="#a78bfa" bgcolor="#17122e" cellborder="0" cellspacing="0" cellpadding="7">
        <tr><td align="left"><font color="#c4b5fd" point-size="12"><b>nuc-flasher · .105 (standalone x86)</b></font></td></tr>
        <tr><td align="left"><font color="#cbb8f0" point-size="9"><b>[ BRUCE WILLIS ]</b> — yippee-ki-yay workhorse</font></td></tr>
        <tr><td align="left"><font color="#a99cd6" point-size="9">Intel i7 amd64 · worker · NFS server · KubeVirt VM host</font></td></tr></table>>];
    zullx [label=<<table border="2" color="#22c55e" bgcolor="#0c2115" cellborder="0" cellspacing="0" cellpadding="7">
        <tr><td align="left"><font color="#4ade80" point-size="12"><b>zullx · .216 (standalone x86)</b></font></td></tr>
        <tr><td align="left"><font color="#9be8ac" point-size="9"><b>[ STEVEN SEAGAL ]</b> — the new muscle</font></td></tr>
        <tr><td align="left"><font color="#86c99a" point-size="9">Ryzen 7 3700X · 62 GB · GPU WORKER<br align="left"/>RTX 2070 SUPER (8GB) · nvidia.com/gpu · NVMe 860Gi</font></td></tr></table>>];
  }

  /* ============ WORKLOADS BY NAMESPACE ============ */
  ai [label=<<table border="2" color="#c084fc" bgcolor="#1a1030" cellborder="0" cellspacing="0" cellpadding="7">
      <tr><td align="left"><font color="#d8b4fe" point-size="12"><b>ns: ai</b></font></td></tr>
      <tr><td align="left"><font color="#b39ddb" point-size="9">• open-webui (LLM chat) ◆5Gi<br align="left"/>• ollama Service ► .110:11434</font></td></tr></table>>];
  mon [label=<<table border="2" color="#38bdf8" bgcolor="#08203a" cellborder="0" cellspacing="0" cellpadding="7">
      <tr><td align="left"><font color="#7dd3fc" point-size="12"><b>ns: monitoring</b></font></td></tr>
      <tr><td align="left"><font color="#8ec5e0" point-size="9">• prometheus ◆15Gi · grafana ◆4Gi · alertmanager<br align="left"/>• node / process / pihole / Jetson-GPU exporters</font></td></tr></table>>];
  vms [label=<<table border="2" color="#a78bfa" bgcolor="#161033" cellborder="0" cellspacing="0" cellpadding="7">
      <tr><td align="left"><font color="#c4b5fd" point-size="12"><b>ns: vms  (KubeVirt)</b></font></td></tr>
      <tr><td align="left"><font color="#a99cd6" point-size="9">• desktop-vm · Ubuntu XFCE ◆25Gi<br align="left"/>► RDP 192.168.1.105:32389</font></td></tr></table>>];
  sys [label=<<table border="2" color="#94a3b8" bgcolor="#111827" cellborder="0" cellspacing="0" cellpadding="7">
      <tr><td align="left"><font color="#cbd5e1" point-size="12"><b>ns: kube-system / kubevirt / cdi</b></font></td></tr>
      <tr><td align="left"><font color="#94a3b8" point-size="9">• traefik · coredns · headlamp · metrics-server<br align="left"/>• nvidia device plugins · virt-* · cdi-* · nfs-provisioner</font></td></tr></table>>];

  /* ============ STORAGE ============ */
  subgraph cluster_store {
    label=<<font color="#fbbf24" point-size="13"><b>  STORAGE  </b></font>>; labeljust=l;
    style="rounded,filled"; fillcolor="#1c1508"; color="#b45309"; penwidth=1.8;
    scloc [label=<<table border="1" color="#f59e0b" bgcolor="#241a09" cellborder="0" cellspacing="0" cellpadding="6"><tr><td align="left"><font color="#fcd34d" point-size="10"><b>SC local-path</b> (default)</font></td></tr><tr><td align="left"><font color="#c99a4a" point-size="8">per-node SSD</font></td></tr></table>>];
    scnfs [label=<<table border="1" color="#f59e0b" bgcolor="#241a09" cellborder="0" cellspacing="0" cellpadding="6"><tr><td align="left"><font color="#fcd34d" point-size="10"><b>SC nfs-client</b> (RWX)</font></td></tr><tr><td align="left"><font color="#c99a4a" point-size="8">NFS on NUC · ~458 GB</font></td></tr></table>>];
    scnvme [label=<<table border="1" color="#f59e0b" bgcolor="#241a09" cellborder="0" cellspacing="0" cellpadding="6"><tr><td align="left"><font color="#fcd34d" point-size="10"><b>SC nvme-local</b> (fast)</font></td></tr><tr><td align="left"><font color="#c99a4a" point-size="8">M.2 NVMe on zullx · 860 GB</font></td></tr></table>>];
  }

  /* ============ ACCESS ============ */
  access [label=<<table border="2" color="#f472b6" bgcolor="#2a0f1e" cellborder="0" cellspacing="0" cellpadding="8">
      <tr><td align="left"><font color="#f9a8d4" point-size="12"><b>ACCESS · NodePort</b></font></td></tr>
      <tr><td align="left"><font color="#d98cb3" point-size="9">Argo CD :32700 · Grafana :32300<br align="left"/>Headlamp :32650 · Open WebUI :32400<br align="left"/>desktop-vm RDP :32389 · Traefik :32289</font></td></tr></table>>];

  /* ============ EDGES ============ */
  internet -> router [color="#38bdf8", penwidth=1.6];
  router -> mikrotik [label="LAN", color="#f97316", penwidth=1.8];
  /* everything hangs off the MikroTik switch */
  mikrotik -> obsw [label="board uplink", color="#f59e0b", penwidth=1.6, lhead=cluster_board];
  mikrotik -> nuc   [color="#6b7280"];
  mikrotik -> zullx [color="#6b7280"];
  mikrotik -> ws    [color="#6b7280"];
  mikrotik -> ph1   [color="#6b7280", lhead=cluster_dns];

  /* Turing Pi on-board switch feeds the 4 modules */
  obsw -> bmc [color="#0891b2"];
  obsw -> cp  [color="#0891b2"];
  obsw -> jet [color="#0891b2"];
  obsw -> w1  [color="#0891b2"];
  obsw -> w2  [color="#0891b2"];

  argocd -> cp [label="syncs / self-heals", color="#34d399", penwidth=2.4, fontcolor="#6ee7b7", ltail=cluster_gitops, lhead=cluster_nodes];
  ai -> ws [label="LLM", color="#a3e635", penwidth=2.2, fontcolor="#bef264", constraint=false];

  mon -> scloc [color="#f59e0b"];
  ai  -> scnfs [color="#f59e0b"];
  vms -> scnfs [color="#f59e0b"];
  scnvme -> zullx [style=dotted, color="#16a34a", label="M.2 on", constraint=false];

  { rank=same; ai; mon; vms; sys; }
}
