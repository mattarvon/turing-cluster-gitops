{
  "title": "Cluster Overview",
  "uid": "cluster-overview",
  "tags": ["cluster", "overview"],
  "timezone": "browser",
  "editable": true,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "schemaVersion": 39,
  "version": 0,
  "panels": [
    { "type": "row", "title": "Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false },
    {
      "type": "stat",
      "title": "Nodes Ready",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(kube_node_status_condition{condition=\"Ready\",status=\"true\"})", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "red", "value": null }, { "color": "orange", "value": 5 }, { "color": "green", "value": 6 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Pods Running",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(kube_pod_status_phase{phase=\"Running\"})", "refId": "A" }],
      "options": { "colorMode": "none", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Pods Not Running",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(kube_pod_status_phase{phase=~\"Failed|Pending|Unknown\"}) or vector(0)", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 3 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Alerts Firing",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "count(ALERTS{alertstate=\"firing\",alertname!=\"Watchdog\"}) or vector(0)", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short", "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Cluster CPU",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 90 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Cluster Memory",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * (1 - sum(node_memory_MemAvailable_bytes) / sum(node_memory_MemTotal_bytes))", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "thresholds": { "mode": "absolute", "steps": [
        { "color": "green", "value": null }, { "color": "yellow", "value": 80 }, { "color": "red", "value": 92 } ] } }, "overrides": [] }
    },

    { "type": "row", "title": "Per-node vitals", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false },
    {
      "type": "timeseries",
      "title": "CPU utilisation by node",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "(100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)) * on(instance) group_left(nodename) node_uname_info", "legendFormat": "{{nodename}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Memory utilisation by node",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "(100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * on(instance) group_left(nodename) node_uname_info", "legendFormat": "{{nodename}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Temperature by node (hottest sensor)",
      "description": "ARM modules throttle around 85C. On this hardware thermal headroom is usually the real ceiling, not CPU capacity.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "max by (instance) (node_hwmon_temp_celsius) * on(instance) group_left(nodename) node_uname_info", "legendFormat": "{{nodename}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "celsius",
        "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never", "thresholdsStyle": { "mode": "dashed" } },
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 65 }, { "color": "orange", "value": 75 }, { "color": "red", "value": 85 } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Load average (1m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "node_load1 * on(instance) group_left(nodename) node_uname_info", "legendFormat": "{{nodename}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short",
        "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },

    { "type": "row", "title": "Storage and network", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }, "collapsed": false },
    {
      "type": "timeseries",
      "title": "Root filesystem used",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "(100 - 100 * node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * on(instance) group_left(nodename) node_uname_info", "legendFormat": "{{nodename}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Network received",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (instance) (rate(node_network_receive_bytes_total{device!~\"lo|veth.*|cni.*|flannel.*|docker.*|kube.*\"}[5m])) * on(instance) group_left(nodename) node_uname_info", "legendFormat": "{{nodename}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "Bps",
        "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Persistent volume used",
      "description": "RWX volumes are served by a single NFS node with no replication. This panel is worth watching.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "100 * kubelet_volume_stats_used_bytes / kubelet_volume_stats_capacity_bytes", "legendFormat": "{{persistentvolumeclaim}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },

    { "type": "row", "title": "Workloads and accelerators", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 31 }, "collapsed": false },
    {
      "type": "timeseries",
      "title": "Pods per node",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (node) (kube_pod_info)", "legendFormat": "{{node}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short",
        "custom": { "lineWidth": 1, "fillOpacity": 20, "showPoints": "never", "stacking": { "mode": "normal" } },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Container restarts (1h)",
      "description": "Anything persistently above zero is crash-looping.",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (namespace, pod) (increase(kube_pod_container_status_restarts_total[1h])) > 0", "legendFormat": "{{namespace}}/{{pod}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short",
        "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "yellow", "value": null }, { "color": "red", "value": 3 } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Jetson GPU utilisation",
      "description": "The embedded ARM GPU. The workstation's RTX 5090 has its own row below.",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "jetson_gpu_utilization_percent", "legendFormat": "GPU utilisation", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 15, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },

    { "type": "row", "title": "RTX 5090 — local inference", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }, "collapsed": false },
    {
      "type": "stat",
      "title": "GPU busy",
      "description": "Above a few percent means something is actively running on the 5090 — usually local model inference.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nvidia_smi_utilization_gpu_ratio * 100", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "noValue": "workstation offline",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "text", "value": null }, { "color": "green", "value": 5 }, { "color": "yellow", "value": 90 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "VRAM used",
      "description": "A loaded model sits resident here. Ollama unloads after its keep-alive expires, and this drops back.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nvidia_smi_memory_used_bytes / nvidia_smi_memory_total_bytes * 100", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "noValue": "workstation offline",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "text", "value": null }, { "color": "green", "value": 5 }, { "color": "yellow", "value": 85 }, { "color": "red", "value": 95 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "GPU temperature",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nvidia_smi_temperature_gpu", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "celsius", "noValue": "workstation offline",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "green", "value": null }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 84 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Power draw",
      "description": "Idles near 30 W. Sustained hundreds of watts means the GPU is genuinely working.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "nvidia_smi_power_draw_watts", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "watt", "noValue": "workstation offline",
        "thresholds": { "mode": "absolute", "steps": [
          { "color": "text", "value": null }, { "color": "green", "value": 100 }, { "color": "yellow", "value": 450 } ] } }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "Inference backend",
      "description": "Whether Prometheus is currently scraping the workstation exporter. Down simply means the desktop is off or asleep — local models are unavailable, hosted models still work.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "up{job=\"gpu-workstation\"} or vector(0)", "refId": "A" }],
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "fieldConfig": { "defaults": { "unit": "short",
        "mappings": [{ "type": "value", "options": {
          "0": { "text": "OFFLINE", "color": "text", "index": 0 },
          "1": { "text": "AVAILABLE", "color": "green", "index": 1 } } }],
        "thresholds": { "mode": "absolute", "steps": [ { "color": "text", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "RTX 5090 utilisation and VRAM",
      "description": "Both are percentages of the same device, so they share one axis honestly.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "nvidia_smi_utilization_gpu_ratio * 100", "legendFormat": "GPU utilisation", "refId": "A" },
        { "expr": "nvidia_smi_memory_used_bytes / nvidia_smi_memory_total_bytes * 100", "legendFormat": "VRAM used", "refId": "B" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100,
        "custom": { "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "RTX 5090 temperature and power",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "nvidia_smi_temperature_gpu", "legendFormat": "Temperature (C)", "refId": "A" },
        { "expr": "nvidia_smi_power_draw_watts", "legendFormat": "Power (W)", "refId": "B" }
      ],
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 5, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },

    { "type": "row", "title": "DNS", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 }, "collapsed": false },
    {
      "type": "timeseries",
      "title": "DNS queries today",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pihole_dns_queries_today", "legendFormat": "{{instance}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "short",
        "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Ads blocked",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 53 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "pihole_ads_percentage_today", "legendFormat": "{{instance}}", "refId": "A" }],
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0,
        "custom": { "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" },
        "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] }
    }
  ]
}
